PORT=3001
NODE_ENV=development
# Alleen gebruikt in productie (NODE_ENV=production) als je de client los van de server host.
# CLIENT_ORIGIN=https://jouw-client-domein.example

# SendGrid (https://sendgrid.com) - voor de eindafrekening per e-mail na het stoppen.
# EMAIL_FROM moet exact het adres zijn dat je bij SendGrid als "Single Sender" hebt geverifieerd
# (Settings > Sender Authentication > Verify a Single Sender) - geen domein nodig, alleen een
# bevestigingsmail klikken. Zonder deze twee variabelen werkt de app gewoon door, alleen wordt
# de afrekeningsmail dan overgeslagen.
SENDGRID_API_KEY=
EMAIL_FROM=
