PORT=3001
NODE_ENV=development
# Alleen gebruikt in productie (NODE_ENV=production) als je de client los van de server host.
# CLIENT_ORIGIN=https://jouw-client-domein.example

# Gmail SMTP - voor de eindafrekening per e-mail na het stoppen. GMAIL_APP_PASSWORD is geen
# normaal wachtwoord maar een "app-wachtwoord": Google-account > Beveiliging > Verificatie in
# twee stappen (moet aanstaan) > App-wachtwoorden. Zonder deze twee variabelen werkt de app
# gewoon door, alleen wordt de afrekeningsmail dan overgeslagen.
GMAIL_USER=
GMAIL_APP_PASSWORD=
